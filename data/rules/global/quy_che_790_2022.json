    {
      "rule_id": "GBL-002",
      "rule_tier": "global",
      "rule_type": "GPA_CALCULATION",
      "source": {
        "document": "790/QĐ-ĐHCNTT-2022",
        "article": "Điều 24-25",
        "section": null
      },
      "applies_to": {
        "cohorts": null,
        "majors": null,
        "program_types": null
      },
      "overrides_rule": null,
      "severity": "hard",
      "note": null,
      "payload": {
        "formula": "A = Σ(grade_i × credits_i) / Σ(credits_i)",
        "rounding": 0.01,
        "gpa_types": {
          "DTBHK": {
            "grade_version": "current_attempt",
            "includes_failed": true,
            "used_for": [
              "academic_warning",
              "scholarship"
            ]
          },
          "DTBC": {
            "grade_version": "highest_attempt",
            "includes_failed": true,
            "used_for": [
              "credit_registration",
              "thesis_eligibility"
            ]
          },
          "DTBCTL": {
            "grade_version": "highest_attempt",
            "includes_failed": false,
            "used_for": [
              "graduation_rank"
            ]
          }
        }
      }
    },
