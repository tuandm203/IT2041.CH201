      }
    },

    {
      "rule_id": "CUR-KHMT-K2023-TH",
      "rule_tier": "curriculum",
      "rule_type": "THESIS_ELIGIBILITY",
      "source": { "document": "CTĐT-KHMT-K2023", "article": "Điều kiện làm khóa luận", "section": null },
      "applies_to": { "cohorts": null, "majors": ["KHMT"], "program_types": ["standard"] },
      "overrides_rule": "GBL-015",
      "severity": "hard",
      "note": "KHMT nâng ngưỡng lên 7.0 so với quy chế chung 6.5.",
      "payload": {
        "max_remaining_credits": 8,
        "min_dtbc": 7.0
      }
    }
  ]
