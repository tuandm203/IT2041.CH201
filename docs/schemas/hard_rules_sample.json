{
  "description": "Ví dụ dữ liệu thực tế — mỗi rule phải pass validate với hard_rules_schema.json",
  "rules": [

    {
      "rule_id": "GBL-001",
      "rule_tier": "global",
      "rule_type": "GRADE_SCALE",
      "source": { "document": "790/QĐ-ĐHCNTT-2022", "article": "Điều 21", "section": "Khoản 1" },
      "applies_to": { "cohorts": null, "majors": null, "program_types": null },
      "overrides_rule": null,
      "severity": "hard",
      "note": "Thang điểm chính thức. Ngưỡng đạt: 5.0/10.",
      "payload": {
        "passing_grade_10": 5.0,
        "rounding": 0.1,
        "excluded_from_gpa": ["GDQP-AN", "GDTC"],
        "scale_entries": [
          {"grade_gte": 9.0, "grade_lt": null, "points_4": 4.0, "letter": "A+", "label": "Xuất sắc",      "passed": true},
          {"grade_gte": 8.0, "grade_lt": 9.0,  "points_4": 3.5, "letter": "A",  "label": "Giỏi",          "passed": true},
          {"grade_gte": 7.0, "grade_lt": 8.0,  "points_4": 3.0, "letter": "B+", "label": "Khá",           "passed": true},
          {"grade_gte": 6.0, "grade_lt": 7.0,  "points_4": 2.5, "letter": "B",  "label": "Trung bình khá","passed": true},
          {"grade_gte": 5.0, "grade_lt": 6.0,  "points_4": 2.0, "letter": "C",  "label": "Trung bình",    "passed": true},
          {"grade_gte": 4.0, "grade_lt": 5.0,  "points_4": 1.5, "letter": "D+", "label": "Yếu",           "passed": false},
          {"grade_gte": 3.0, "grade_lt": 4.0,  "points_4": 1.0, "letter": "D",  "label": "Kém",           "passed": false},
          {"grade_gte": 0.0, "grade_lt": 3.0,  "points_4": 0.0, "letter": "F",  "label": "",              "passed": false}
        ]
      }
    },

    {
      "rule_id": "GBL-002",
      "rule_tier": "global",
      "rule_type": "GPA_CALCULATION",
      "source": { "document": "790/QĐ-ĐHCNTT-2022", "article": "Điều 24-25", "section": null },
      "applies_to": { "cohorts": null, "majors": null, "program_types": null },
      "overrides_rule": null,
      "severity": "hard",
      "note": null,
      "payload": {
        "formula": "A = Σ(grade_i × credits_i) / Σ(credits_i)",
        "rounding": 0.01,
        "gpa_types": {
          "DTBHK":  { "grade_version": "current_attempt", "includes_failed": true,  "used_for": ["academic_warning", "scholarship"] },
          "DTBC":   { "grade_version": "highest_attempt",  "includes_failed": true,  "used_for": ["credit_registration", "thesis_eligibility"] },
          "DTBCTL": { "grade_version": "highest_attempt",  "includes_failed": false, "used_for": ["graduation_rank"] }
        }
      }
    },

    {
      "rule_id": "GBL-003",
      "rule_tier": "global",
      "rule_type": "ENROLLMENT_CREDIT_LIMIT",
      "source": { "document": "790/QĐ-ĐHCNTT-2022", "article": "Điều 14", "section": "Khoản 1, mục a" },
      "applies_to": { "cohorts": null, "majors": null, "program_types": null },
      "overrides_rule": null,
      "severity": "hard",
      "note": "Áp dụng học kỳ chính. Trường hợp đặc biệt cần Hiệu trưởng chấp thuận.",
      "payload": {
        "semester_type": "main",
        "tiers": [
          {"dtbc_lt": 8.0,  "dtbc_gte": null, "min_credits": 14, "max_credits": 24},
          {"dtbc_gte": 8.0, "dtbc_lt": null,  "min_credits": 14, "max_credits": 30}
        ],
        "exception_remaining_lt_14": { "min_credits": null, "max_credits": 24 }
      }
    },

    {
      "rule_id": "GBL-004",
      "rule_tier": "global",
      "rule_type": "ENROLLMENT_CREDIT_LIMIT",
      "source": { "document": "790/QĐ-ĐHCNTT-2022", "article": "Điều 14", "section": "Khoản 1, mục b" },
      "applies_to": { "cohorts": null, "majors": null, "program_types": null },
      "overrides_rule": null,
      "severity": "hard",
      "note": "Học kỳ hè: chỉ được đăng ký môn mới nếu DTBC >= 7.0",
      "payload": {
        "semester_type": "summer",
        "max_credits": 12,
        "allowed_types": ["retake", "improvement", "foreign_language", "internship"],
        "new_course_allowed_if_dtbc_gte": 7.0
      }
    },

    {
      "rule_id": "GBL-005",
      "rule_tier": "global",
      "rule_type": "RETAKE_MANDATORY",
      "source": { "document": "790/QĐ-ĐHCNTT-2022", "article": "Điều 14", "section": "Khoản 2" },
      "applies_to": { "cohorts": null, "majors": null, "program_types": null },
      "overrides_rule": null,
      "severity": "hard",
      "note": "Môn tự chọn <5.0 được phép chọn môn thay thế trong nhóm tương ứng thay vì học lại đúng môn đó.",
      "payload": {
        "trigger_grade_lt": 5.0,
        "mandatory_course_action": "must_retake_same",
        "elective_course_action": "may_substitute_within_group"
      }
    },

    {
      "rule_id": "GBL-006",
      "rule_tier": "global",
      "rule_type": "RETAKE_OPTIONAL",
      "source": { "document": "790/QĐ-ĐHCNTT-2022", "article": "Điều 14", "section": "Khoản 3" },
      "applies_to": { "cohorts": null, "majors": null, "program_types": null },
      "overrides_rule": null,
      "severity": "soft",
      "note": null,
      "payload": {
        "trigger_grade_gte": 5.0,
        "grade_policy": "take_highest"
      }
    },

    {
      "rule_id": "GBL-007",
      "rule_tier": "global",
      "rule_type": "ATTENDANCE_REQUIREMENT",
      "source": { "document": "790/QĐ-ĐHCNTT-2022", "article": "Điều 20", "section": "Khoản 1" },
      "applies_to": { "cohorts": null, "majors": null, "program_types": null },
      "overrides_rule": null,
      "severity": "hard",
      "note": null,
      "payload": {
        "min_attendance_rate": 0.80,
        "consequence_if_below": "banned_from_final_exam"
      }
    },

    {
      "rule_id": "GBL-008",
      "rule_tier": "global",
      "rule_type": "ACADEMIC_WARNING",
      "source": { "document": "790/QĐ-ĐHCNTT-2022", "article": "Điều 16", "section": "Khoản 1" },
      "applies_to": { "cohorts": null, "majors": null, "program_types": null },
      "overrides_rule": null,
      "severity": "hard",
      "note": "Tự động xóa sau 1 kỳ chính nếu không tái phạm.",
      "payload": {
        "trigger_any_of": [
          {"type": "DTBHK_lt",             "threshold": 3.0},
          {"type": "consecutive_DTBHK_lt", "threshold": 4.0, "consecutive_semesters": 2},
          {"type": "tuition_unpaid"}
        ],
        "duration_semesters": 1
      }
    },

    {
      "rule_id": "GBL-009",
      "rule_tier": "global",
      "rule_type": "ACADEMIC_SUSPENSION",
      "source": { "document": "790/QĐ-ĐHCNTT-2022", "article": "Điều 16", "section": "Khoản 2" },
      "applies_to": { "cohorts": null, "majors": null, "program_types": null },
      "overrides_rule": null,
      "severity": "hard",
      "note": "Đình chỉ 1 kỳ — khác với thôi học (Khoản 3).",
      "payload": {
        "trigger_any_of": [
          {"type": "exam_fraud_first_offense"},
          {"type": "disciplinary_during_warning"}
        ],
        "duration_semesters": 1
      }
    },

    {
      "rule_id": "GBL-010",
      "rule_tier": "global",
      "rule_type": "ACADEMIC_EXPULSION",
      "source": { "document": "790/QĐ-ĐHCNTT-2022", "article": "Điều 16", "section": "Khoản 3" },
      "applies_to": { "cohorts": null, "majors": null, "program_types": null },
      "overrides_rule": null,
      "severity": "hard",
      "note": null,
      "payload": {
        "trigger_any_of": [
          {"type": "DTBHK_zero_consecutive",   "consecutive_semesters": 2},
          {"type": "warning_twice_consecutive"},
          {"type": "exceeded_max_duration"},
          {"type": "twice_suspended"},
          {"type": "serious_disciplinary"}
        ]
      }
    },

    {
      "rule_id": "GBL-011",
      "rule_tier": "global",
      "rule_type": "GRADUATION_REQUIREMENT",
      "source": { "document": "790/QĐ-ĐHCNTT-2022", "article": "Điều 33", "section": "Khoản 1" },
      "applies_to": { "cohorts": null, "majors": null, "program_types": null },
      "overrides_rule": null,
      "severity": "hard",
      "note": "Phải thỏa TẤT CẢ để nộp hồ sơ xét tốt nghiệp.",
      "payload": {
        "must_satisfy_all": [
          {"condition": "no_criminal_or_major_discipline"},
          {"condition": "tuition_paid"},
          {"condition": "all_curriculum_credits_fulfilled"},
          {"condition": "physical_education_completed"},
          {"condition": "national_defense_certificate"},
          {"condition": "foreign_language_standard_met"},
          {"condition": "conduct_score_gte", "value": 50},
          {"condition": "library_books_returned"}
        ]
      }
    },

    {
      "rule_id": "GBL-012",
      "rule_tier": "global",
      "rule_type": "GRADUATION_RANK",
      "source": { "document": "790/QĐ-ĐHCNTT-2022", "article": "Điều 34", "section": "Khoản 2" },
      "applies_to": { "cohorts": null, "majors": null, "program_types": null },
      "overrides_rule": null,
      "severity": "hard",
      "note": "Dựa trên DTBCTL thang 4. Ranh giới: gte lower bound, lt upper bound.",
      "payload": {
        "basis": "DTBCTL",
        "ranks": [
          {"label": "Xuất sắc",      "dtbctl_gte": 3.6, "dtbctl_lt": null},
          {"label": "Giỏi",          "dtbctl_gte": 3.2, "dtbctl_lt": 3.6},
          {"label": "Khá",           "dtbctl_gte": 2.5, "dtbctl_lt": 3.2},
          {"label": "Trung bình khá","dtbctl_gte": 2.0, "dtbctl_lt": 2.5},
          {"label": "Trung bình",    "dtbctl_gte": 0.0, "dtbctl_lt": 2.0}
        ]
      }
    },

    {
      "rule_id": "GBL-013",
      "rule_tier": "global",
      "rule_type": "GRADUATION_RANK_DOWNGRADE",
      "source": { "document": "790/QĐ-ĐHCNTT-2022", "article": "Điều 34", "section": "Khoản 2" },
      "applies_to": { "cohorts": null, "majors": null, "program_types": null },
      "overrides_rule": null,
      "severity": "hard",
      "note": "Dù vi phạm nhiều điều kiện vẫn chỉ giảm tối đa 1 bậc.",
      "payload": {
        "downgrade_by": 1,
        "max_downgrade": 1,
        "cases": [
          {
            "applies_to_rank": "Xuất sắc",
            "trigger_any_of": [
              {"type": "exceeded_semesters",       "value": 2},
              {"type": "had_disciplinary_warning"},
              {"type": "retake_ratio_gt",          "value": 0.05},
              {"type": "conduct_score_lt",         "value": 75}
            ]
          },
          {
            "applies_to_rank": "Giỏi",
            "trigger_any_of": [
              {"type": "conduct_score_lt", "value": 65}
            ]
          }
        ]
      }
    },

    {
      "rule_id": "GBL-014",
      "rule_tier": "global",
      "rule_type": "PROGRAM_TOTAL_CREDITS",
      "source": { "document": "790/QĐ-ĐHCNTT-2022", "article": "Điều 7", "section": "Khoản 1" },
      "applies_to": { "cohorts": null, "majors": null, "program_types": ["standard"] },
      "overrides_rule": null,
      "severity": "hard",
      "note": "Chương trình chuyên sâu đặc thù yêu cầu tối thiểu 150 TC.",
      "payload": {
        "min_credits": 120,
        "max_credits": 132,
        "excluded_from_count": ["GDQP-AN", "GDTC"],
        "max_study_semesters": 12
      }
    },

    {
      "rule_id": "GBL-015",
      "rule_tier": "global",
      "rule_type": "THESIS_ELIGIBILITY",
      "source": { "document": "790/QĐ-ĐHCNTT-2022", "article": "Điều 31", "section": "Khoản 3" },
      "applies_to": { "cohorts": null, "majors": null, "program_types": ["standard"] },
      "overrides_rule": null,
      "severity": "hard",
      "note": "Từng khoa có thể nâng min_dtbc — xem curriculum override.",
      "payload": {
        "max_remaining_credits": 8,
        "min_dtbc": 6.5
      }
    },

    {
      "rule_id": "CUR-CNTT-K2023-001",
      "rule_tier": "curriculum",
      "rule_type": "COURSE_PREREQUISITE",
