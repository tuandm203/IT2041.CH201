      }
    },

    {
      "rule_id": "CUR-CNTT-K2023-002",
      "rule_tier": "curriculum",
      "rule_type": "COURSE_PRIOR",
      "source": { "document": "CTĐT-CNTT-K2023", "article": "Bảng học phần", "section": null },
      "applies_to": { "cohorts": ["K2023"], "majors": ["CNTT"], "program_types": null },
