{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UIT Hard Rules Schema",
  "description": "Schema validate cấu trúc một rule object. Source of truth: Quy chế 790/QĐ-ĐHCNTT-2022.",

  "definitions": {

    "RuleSource": {
      "type": "object",
      "properties": {
        "document": { "type": "string" },
        "url":      { "type": ["string", "null"] },
        "article":  { "type": "string" },
        "section":  { "type": ["string", "null"] },
        "page":     { "type": ["integer", "null"] }
      },
      "required": ["document", "article"],
      "additionalProperties": false
    },

    "AppliesTo": {
      "type": "object",
      "description": "Phạm vi áp dụng. null = áp dụng toàn bộ.",
      "properties": {
        "cohorts": {
          "type": ["array", "null"],
          "items": { "type": "string", "pattern": "^K20\\d{2}$" }
        },
        "majors": {
          "type": ["array", "null"],
          "items": {
            "type": "string",
            "enum": ["CNTT","HTTT","KHMT","KTPM","KTMT","MMT&TTDL","ATTT","TMDT","KHdl","TTNT","TKVM","TTDM"]
          }
        },
        "program_types": {
          "type": ["array", "null"],
          "items": { "type": "string", "enum": ["standard","talent","advanced","international","high_quality","second_degree","transfer"] }
        }
      },
      "additionalProperties": false
    },

    "CourseRef": {
      "type": "object",
      "properties": {
        "course_id":   { "type": "string" },
        "course_name": { "type": ["string", "null"] },
        "credits":     { "type": ["integer", "null"] }
      },
      "required": ["course_id"],
      "additionalProperties": false
    }
  },

  "type": "object",
  "properties": {
    "rule_id":       { "type": "string", "description": "ID duy nhất, ví dụ: GBL-001, CUR-CNTT-K2023-001" },
    "rule_tier":     { "type": "string", "enum": ["global", "curriculum"] },
    "rule_type":     {
      "type": "string",
      "enum": [
        "GRADE_SCALE",
        "GPA_CALCULATION",
        "ENROLLMENT_CREDIT_LIMIT",
        "RETAKE_MANDATORY",
        "RETAKE_OPTIONAL",
        "ATTENDANCE_REQUIREMENT",
        "ACADEMIC_WARNING",
        "ACADEMIC_SUSPENSION",
        "ACADEMIC_EXPULSION",
        "GRADUATION_REQUIREMENT",
        "GRADUATION_RANK",
        "GRADUATION_RANK_DOWNGRADE",
        "PROGRAM_STRUCTURE",
        "PROGRAM_TOTAL_CREDITS",
        "COURSE_GROUP_REQUIREMENT",
        "COURSE_PREREQUISITE",
        "COURSE_PRIOR",
        "COURSE_COREQUISITE",
        "COURSE_EQUIVALENT",
        "COURSE_REPLACEMENT",
        "THESIS_ELIGIBILITY",
        "FOREIGN_LANGUAGE_STANDARD",
        "CREDIT_TRANSFER"
      ]
    },
    "source":         { "$ref": "#/definitions/RuleSource" },
    "applies_to":     { "$ref": "#/definitions/AppliesTo" },
    "overrides_rule": { "type": ["string", "null"], "description": "rule_id của GLOBAL rule bị override. null nếu là rule mới." },
    "severity":       { "type": "string", "enum": ["hard", "soft"] },
    "note":           { "type": ["string", "null"] },
    "payload":        { "type": "object" }
  },
  "required": ["rule_id", "rule_tier", "rule_type", "source", "applies_to", "severity", "payload"],
  "additionalProperties": false
}
